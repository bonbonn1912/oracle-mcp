# Kopieren nach .env (liegt neben dist/, wird nicht eingecheckt).
# Werte aus dem env-Block der Gemini settings.json haben Vorrang.

# Lokale Datenbank (Verbindung "local")
ORACLE_PASSWORD=passwort-der-lokalen-datenbank

# Passwörter der Server aus connections.json: ORACLE_PASSWORD_<NAME>, Bindestriche als Unterstrich.
ORACLE_PASSWORD_DB1=...
ORACLE_PASSWORD_DB2=...
# Steht in connections.json ein "passwordEnv", gilt stattdessen dieser Name.

# optional, Standardwerte der lokalen Verbindung:
# ORACLE_HOST=localhost
# ORACLE_PORT=1521
# ORACLE_SERVICE=XEPDB1
# ORACLE_USER=sys
# ORACLE_PRIVILEGE=SYSDBA
