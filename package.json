{
  "name": "oracle-mcp",
  "version": "0.2.0",
  "description": "MCP server for local Oracle databases (19c / 21c XE), built for the Gemini CLI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "oracle-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "oracledb": "^7.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/oracledb": "^7.0.3",
    "typescript": "^5.9.0"
  }
}
